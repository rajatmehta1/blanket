{
  "fixture": "fixture-soc2-partial",
  "description": "SOC2 partial compliance: authentication exists but uses MD5, RBAC exists but overly permissive, logging exists but missing structured fields, command injection via os.system",
  "files": [
    "auth_service.py",
    "access_control.py",
    "monitoring.py"
  ],
  "expected_findings": {
    "must_find": [
      {
        "category": "security",
        "severity": "high",
        "pattern": "weak.*(hash|crypto)|md5",
        "description": "MD5 used for password hashing in auth_service.py line 9",
        "min_count": 1
      },
      {
        "category": "security",
        "severity": "critical",
        "pattern": "command.injection|os\\.system",
        "description": "os.system call with unsanitized input in access_control.py line 14",
        "min_count": 1
      },
      {
        "category": "compliance",
        "pattern": "permissive.*role|overly.*permissive|excessive.*permission|rbac",
        "description": "User role has delete permission — overly permissive RBAC in access_control.py line 5",
        "min_count": 1
      },
      {
        "category": "compliance",
        "pattern": "log.*field|structured.*log|insufficient.*log|missing.*log.*field",
        "description": "Logging missing required fields (scan_id, user_id, timestamp) in monitoring.py",
        "min_count": 1
      }
    ],
    "must_not_find": [
      {
        "category": "security",
        "pattern": "sql.injection",
        "reason": "No SQL queries in this fixture"
      },
      {
        "category": "security",
        "pattern": "hardcoded.*(password|secret|key|credential)",
        "reason": "No hardcoded secrets in this fixture"
      },
      {
        "category": "compliance",
        "pattern": "no.*auth|missing.*auth|unauthenticated",
        "reason": "Authentication exists (auth_service.py) even though it uses weak hashing"
      }
    ]
  },
  "expected_severity_counts": {
    "critical": { "min": 1, "max": 3 },
    "high": { "min": 1, "max": 6 },
    "medium": { "min": 1, "max": 10 },
    "low": { "min": 0, "max": 8 }
  },
  "expected_score": {
    "overall": { "min": 30, "max": 70 },
    "grade": ["C", "D"]
  },
  "expected_compliance": {
    "SOC2": {
      "must_have_controls": [
        "CC6.1",
        "CC7.2",
        "CC8.1"
      ],
      "expected_statuses": [
        {
          "clause_pattern": "CC6\\.1",
          "title_pattern": "logical.*access|access.control",
          "expected_status": ["partial"],
          "reason": "Auth exists but uses weak hashing; RBAC exists but overly permissive"
        },
        {
          "clause_pattern": "CC7\\.2",
          "title_pattern": "monitor|anomal|detect",
          "expected_status": ["partial", "fail"],
          "reason": "Logging exists but missing structured fields"
        },
        {
          "clause_pattern": "CC8\\.1",
          "title_pattern": "change.management|change.control",
          "expected_status": ["fail"],
          "reason": "os.system deploys directly with no change management process"
        }
      ]
    }
  },
  "expected_evidence_files": [
    "auth_service.py",
    "access_control.py",
    "monitoring.py"
  ]
}
