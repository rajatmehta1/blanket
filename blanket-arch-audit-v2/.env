# ═══════════════════════════════════════════════════════════════
# BlanketAudit Environment Variables
# Copy to .env and fill in your values.
# All variables use the BLANKETAUDIT_ prefix.
# ═══════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────
# Options: anthropic, openai, ollama, groq, google, azure, none

#GROQ Specific
BLANKETAUDIT_LLM__PROVIDER=groq
BLANKETAUDIT_LLM__MODEL=llama-3.3-70b-versatile
BLANKETAUDIT_LLM__COMPLIANCE_MODEL=
BLANKETAUDIT_LLM__TEMPERATURE=0.0

# BLANKETAUDIT_LLM__PROVIDER=ollama
# BLANKETAUDIT_LLM__MODEL=qwen2.5-coder:7b
# BLANKETAUDIT_LLM__BASE_URL=http://192.168.1.53:11434
# BLANKETAUDIT_EMBEDDING__PROVIDER=ollama
# BLANKETAUDIT_EMBEDDING__MODEL=nomic-embed-text


# Provider API keys (set the one matching your provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=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
GOOGLE_API_KEY=

# ── Embedding Provider ───────────────────────────────────────
# Options: openai, ollama, huggingface, voyage, none
BLANKETAUDIT_EMBEDDING__PROVIDER=none
BLANKETAUDIT_EMBEDDING__MODEL=

# ── Cost Controls ────────────────────────────────────────────
BLANKETAUDIT_COST__MAX_SCAN_COST_USD=15.00
BLANKETAUDIT_COST__PER_AGENT_TOKEN_BUDGET=500000
BLANKETAUDIT_COST__REQUIRE_DRY_RUN=false

# ── Storage ──────────────────────────────────────────────────
BLANKETAUDIT_NEO4J_URI=bolt://localhost:7687
BLANKETAUDIT_NEO4J_USER=neo4j
BLANKETAUDIT_NEO4J_PASSWORD=
BLANKETAUDIT_MILVUS_URI=http://localhost:19530
BLANKETAUDIT_SQLITE_PATH=blanketaudit.db

# ── Observability ────────────────────────────────────────────
BLANKETAUDIT_LOG_LEVEL=INFO
BLANKETAUDIT_LOG_JSON=true
BLANKETAUDIT_OTEL_ENDPOINT=
BLANKETAUDIT_SENTRY_DSN=

# ── Domain & Frameworks ──────────────────────────────────────
BLANKETAUDIT_DOMAIN=general
# Comma-separated: hipaa,soc2,pci_dss,gdpr
BLANKETAUDIT_ACTIVE_FRAMEWORKS=[]

# ── GitHub/GitLab/Bitbucket Tokens ───────────────────────────
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
